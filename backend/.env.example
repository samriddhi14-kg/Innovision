# ==============================================================================
# KhetRakshak — Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Required)
# Get these from: https://app.supabase.com → Project → Settings → API
# Use the "service_role" key (not the anon key) for backend access.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# Telegram Bot API (Required — for farmer detection alerts)
# 1. Open Telegram → search @BotFather → /newbot → copy the token
# 2. Get your Chat ID by messaging @userinfobot or checking bot updates
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDEEFFaabbccddeeff-your_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ------------------------------------------------------------------------------
# Arduino Serial & Hardware Settings
# SERIAL_PORT: COM3 on Windows  |  /dev/ttyUSB0 on Linux
# BAUD_RATE: must match the baud rate set in your Arduino sketch (default 9600)
# ------------------------------------------------------------------------------
SERIAL_PORT=COM3
BAUD_RATE=9600

# ------------------------------------------------------------------------------
# Camera Settings
# CAMERA_INDEX: 0 = first USB/built-in camera, 1 = second camera, etc.
# ------------------------------------------------------------------------------
CAMERA_INDEX=0

# ------------------------------------------------------------------------------
# YOLO Model Path (Required — path to your trained .pt model file)
# Place your monkey detection model in the backend/models/ directory.
# ------------------------------------------------------------------------------
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.5

# ------------------------------------------------------------------------------
# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
